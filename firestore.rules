rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read, write: if true;
      match /studentTokens/{tokenId} {
        allow read, write: if true;
      }
      match /answerKeys/{keyId} {
        allow read, write: if true;
      }
    }
    match /teacherProfiles/{uid} {
      allow read, write: if true;
    }
    match /rateLimits/{key} {
      allow read, write: if true;
    }
  }
}
