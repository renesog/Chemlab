# Firebase Client (public - safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public app URL (for QR codes)
NEXT_PUBLIC_APP_URL=

# Firebase Admin (server-only — KEEP SECRET!)
# Go to Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the ENTIRE JSON content as a single line here
FIREBASE_SERVICE_ACCOUNT_KEY=

# App Secrets
STUDENT_SESSION_SECRET=change-me-to-random-32-chars
ROOM_CODE_PEPPER=change-me-to-another-random-string
